# Wingman AI environment configuration
# Copy this file to .env and fill in what you need.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Option 1: Google Gemini (cloud). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Ollama (local / private). Install https://ollama.com, then: ollama pull llama3.2
USE_OLLAMA=false
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# ── Speech-to-text (live transcription) ───────────────────────────────────────
# Leave WHISPER_URL empty to transcribe with Gemini (needs GEMINI_API_KEY).
# Set it to any OpenAI-compatible /v1/audio/transcriptions endpoint for fully
# local transcription, e.g.:
#   docker run --rm -p 8000:8000 ghcr.io/speaches-ai/speaches:latest-cpu
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
# Optional: force a language (ISO code, e.g. en, hi). Auto-detected if empty.
WHISPER_LANGUAGE=
# Optional: force a backend: whisper | gemini
TRANSCRIPTION_PROVIDER=
