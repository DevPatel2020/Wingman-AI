# Cluely Environment Configuration
# Copy this file to .env and fill in your API keys

# Option 1: Use Google Gemini (Cloud AI)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Use Ollama (Local/Private AI - Recommended for Privacy)
# Set USE_OLLAMA=true to use Ollama instead of Gemini
# Make sure Ollama is installed and running: https://ollama.ai
USE_OLLAMA=false
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Note: You need EITHER GEMINI_API_KEY OR USE_OLLAMA=true
# If USE_OLLAMA=true, GEMINI_API_KEY is not required

